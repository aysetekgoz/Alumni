# Bu dosya şablondur ve git'e eklenir. Gerçek değerler yok.
# Kullanım: bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# ".env" git tarafından yok sayılır (.gitignore), commit etmeyin.

# --- PostgreSQL (docker-compose.yml içindeki "db" servisi) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=your_db_name
